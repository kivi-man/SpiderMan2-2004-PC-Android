@@ -349,3 +370,16 @@ compiler_context_t::destroy_fp(nvfx_fragment_program * nvfx_fp)
     return;
   }
 }
+
+// RSXGL_RELEASE_PATCH: the linked shaders (IR with the built-ins, TGSI) once the program is translated
+void
+compiler_context_t::release_linked(struct gl_shader_program * program)
+{
+  for(unsigned int i = 0;i < MESA_SHADER_TYPES;++i) {
+    struct gl_shader * sh = program -> _LinkedShaders[i];
+    if(sh == 0) continue;
+    _mesa_reference_program(mesa_ctx,&sh -> Program,NULL);
+    ralloc_free(sh);
+    program -> _LinkedShaders[i] = 0;
+  }
+}
