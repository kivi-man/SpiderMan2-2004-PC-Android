+// RSXGL_RELEASE2_PATCH: st_delete_program's work for RSXGL's programs
+static void
+rsxgl_delete_program(struct gl_context * ctx,struct gl_program * prog)
+{
+  if(prog -> Target == GL_VERTEX_PROGRAM_ARB) {
+    struct st_vertex_program * stvp = (struct st_vertex_program *)prog;
+    if(stvp -> glsl_to_tgsi) free_glsl_to_tgsi_visitor(stvp -> glsl_to_tgsi);
+    stvp -> glsl_to_tgsi = 0;
+  }
+  else if(prog -> Target == GL_FRAGMENT_PROGRAM_ARB) {
+    struct st_fragment_program * stfp = (struct st_fragment_program *)prog;
+    if(stfp -> glsl_to_tgsi) free_glsl_to_tgsi_visitor(stfp -> glsl_to_tgsi);
+    stfp -> glsl_to_tgsi = 0;
+    if(stfp -> tgsi.tokens) free((void *)stfp -> tgsi.tokens);  // ureg_get_tokens: MALLOC
+    stfp -> tgsi.tokens = 0;
+  }
+  _mesa_delete_program(ctx,prog);
+}
